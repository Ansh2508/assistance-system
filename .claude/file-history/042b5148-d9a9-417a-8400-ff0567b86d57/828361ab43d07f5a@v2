/**
 * F7 Media Analysis — HTTP surface.
 *
 * Types mirror packages/contracts/generated/clara.d.ts (MediaAnalysis, TrustLevel).
 * Inlined per the established convention in features/briefing + features/watchlist.
 *
 *   GET /api/media/{policy_id}  →  MediaAnalysis
 *
 * Returns null on 404 (policy unknown) rather than throwing — lets the panel
 * show a soft "no analysis yet" state instead of crashing the dashboard.
 */

import { ApiError, apiClient } from "@shared/api";

export type TrustLevel = "low" | "medium" | "high";

export interface MediaAnalysis {
  policy_id: string;
  official_framing: string;
  media_focus: string;
  hidden_impact: string;
  deadline_alert: string | null;
  watch_out_for: string;
  trust_level: TrustLevel;
}

export async function fetchMedia(policyId: string): Promise<MediaAnalysis | null> {
  try {
    return await apiClient.get<MediaAnalysis>(
      `/media/${encodeURIComponent(policyId)}`,
    );
  } catch (err) {
    if (err instanceof ApiError && err.status === 404) return null;
    throw err;
  }
}
