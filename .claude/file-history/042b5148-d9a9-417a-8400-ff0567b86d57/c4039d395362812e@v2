/**
 * F3 Feed — HTTP surface.
 *
 * Types mirror packages/contracts/generated/clara.d.ts (FeedCard, Urgency).
 * Inlined because apps/web has no @contracts path alias — this is the
 * convention across the FE (features/briefing, features/citations,
 * features/watchlist).
 *
 * The only backend endpoint F3 exposes:
 *   GET /api/feed?persona_id=<id>  →  FeedCard[]
 *
 * F3 also owns GET /api/events (SSE), but the SSE client lives in
 * shared/sse/ since it's an infrastructure concern — the feed feature only
 * consumes the fanned events off the shared bus.
 */

import { apiClient } from "@shared/api";

export type Urgency = "low" | "medium" | "high";

export interface FeedCard {
  policy_id: string;
  title: string;
  source_name: string;
  relevance_score: number;
  urgency: Urgency;
  preview: string;
}

export async function fetchFeed(personaId: string): Promise<FeedCard[]> {
  const query = new URLSearchParams({ persona_id: personaId }).toString();
  return apiClient.get<FeedCard[]>(`/feed?${query}`);
}
