def test_get_watchlist_unknown_persona_returns_empty_list() -> None:
    app = FastAPI()
    wire(
        app,
        bus=AsyncioEventBus(),
        llm=_SpyLLM(),
        watchitems=InMemoryRepository[WatchItem]("watchitems"),
    )
    client = TestClient(app)
    resp = client.get("/api/watchlist", params={"persona_id": "ghost"})
    assert resp.status_code == HTTP_OK
    assert resp.json() == []


# ---------------------------------------------------------------------------
# 8. Prompt serialization excludes embedding (cache friendliness)
# ---------------------------------------------------------------------------


def test_persona_prompt_json_excludes_embedding_and_created_at() -> None:
    profile = _make_persona("persona_slim")
    # Force a non-empty embedding to prove it's stripped.
    profile_with_embedding = profile.model_copy(update={"embedding": [0.1, 0.2, 0.3]})
    serialized = _persona_to_prompt_json(profile_with_embedding)
    data = json.loads(serialized)
    assert "embedding" not in data
    assert "created_at" not in data
    assert data["id"] == "persona_slim"


# ---------------------------------------------------------------------------
# 9. Empty LLM response (parseable but no items) → parse guard rejects
# ---------------------------------------------------------------------------


@pytest.mark.asyncio
async def test_empty_items_list_fails_parse_guard() -> None:
    # `{"items": []}` parses as JSON but fails the WatchlistLLMResponse
    # min_length=1 constraint, so the use case retries.
    llm = _SpyLLM(responses=['{"items": []}', '{"items": []}'])
    repo: InMemoryRepository[WatchItem] = InMemoryRepository("watchitems")
    bus = _CapturingBus()
    use_case = WatchlistUseCase(llm=llm, watchitems=repo, bus=bus)

    items = await use_case.generate_for_persona(_make_persona("persona_empty"))

    assert items == []
    assert llm.complete_calls == EXPECTED_LLM_CALLS_RETRY
    assert not any(isinstance(e, WatchlistReady) for e in bus.published)


# ---------------------------------------------------------------------------
# 10. Persona filter on the repository (sibling persona rows not leaked)
# ---------------------------------------------------------------------------


@pytest.mark.asyncio
async def test_list_for_persona_isolates_by_persona_id() -> None:
    llm = _SpyLLM()
    repo: InMemoryRepository[WatchItem] = InMemoryRepository("watchitems")
    bus = _CapturingBus()
    use_case = WatchlistUseCase(llm=llm, watchitems=repo, bus=bus)

    await use_case.generate_for_persona(_make_persona("persona_a"))
    await use_case.generate_for_persona(_make_persona("persona_b"))

    a = await use_case.list_for_persona("persona_a")
    b = await use_case.list_for_persona("persona_b")
    assert len(a) == EXPECTED_ITEMS
    assert len(b) == EXPECTED_ITEMS
    assert all(i.persona_id == "persona_a" for i in a)
    assert all(i.persona_id == "persona_b" for i in b)
    # Deterministic ids → a and b are disjoint sets.
    assert {i.id for i in a}.isdisjoint({i.id for i in b})
