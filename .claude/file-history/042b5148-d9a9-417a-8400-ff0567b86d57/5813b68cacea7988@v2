class _SpyLLM:
    """Records every complete() call so the anti-hardcoding test can assert
    call count > 0 AND so retry tests can program per-call responses."""

    def __init__(self, responses: list[str] | None = None) -> None:
        self.complete_calls = 0
        self.stream_calls = 0
        self._responses = responses or [json.dumps(_VALID_PAYLOAD)]
        self.last_system: str | None = None
        self.last_user: str | None = None

    async def complete(
        self,
        *,
        system: str,
        messages: list[dict[str, str]],
        cache_breakpoints: list[int] | None = None,
        temperature: float = 0.3,
        max_tokens: int = 1024,
        response_format: dict[str, str] | None = None,
    ) -> str:
        idx = min(self.complete_calls, len(self._responses) - 1)
        self.last_system = system
        self.last_user = messages[-1]["content"] if messages else None
        self.complete_calls += 1
        return self._responses[idx]

    def stream(
        self, *, system: str, messages: list[dict[str, str]]
    ) -> AsyncIterator[str]:
        self.stream_calls += 1
        raise NotImplementedError


def _make_persona(id: str = "persona_maria") -> PersonaProfile:
    return PersonaProfile(
        id=id,
        name="Maria",
        situation_summary="Ukrainian refugee in Munich, part-time, low income.",
        city="Munich",
        language="uk",
        legal_status_area="refugee",
        financial_vulnerability="high",
        primary_concerns=["housing", "work_permit", "benefits"],
        policy_sensitivity_areas=["housing", "work_permit", "benefits"],
        communication_tone="warm",
        likely_excluded_from=["Kindergeld"],
        embedding=None,
        created_at=NOW,
    )


class _CapturingBus:
    def __init__(self) -> None:
        self.published: list[Any] = []

    def subscribe(self, event_type: str, handler: Any) -> None:
        pass

    async def publish(self, event: Any) -> None:
        self.published.append(event)

    async def close(self) -> None:
        pass


# ---------------------------------------------------------------------------
# 1. Valid LLM JSON → 3 items persisted, event fires, persona_id matches
# ---------------------------------------------------------------------------


@pytest.mark.asyncio
async def test_valid_llm_response_persists_three_items_and_publishes() -> None:
    llm = _SpyLLM()
    repo: InMemoryRepository[WatchItem] = InMemoryRepository("watchitems")
    bus = _CapturingBus()
    use_case = WatchlistUseCase(llm=llm, watchitems=repo, bus=bus)

    profile = _make_persona("persona_t1")
    items = await use_case.generate_for_persona(profile)

    assert len(items) == EXPECTED_ITEMS
    assert all(i.persona_id == "persona_t1" for i in items)
    # Every item has a non-empty action_if_passes (the prompt invariant).
    assert all(i.action_if_passes for i in items)
    # Event fired exactly once.
    ready = [e for e in bus.published if isinstance(e, WatchlistReady)]
    assert len(ready) == 1
    assert ready[0].persona_id == "persona_t1"
    assert len(ready[0].items) == EXPECTED_ITEMS
    # Items landed in the repository (keyed by generated id).
    stored = await repo.list(filter={"persona_id": "persona_t1"})
    assert len(stored) == EXPECTED_ITEMS


# ---------------------------------------------------------------------------
# 2. Deterministic ids → repeat calls upsert (no row duplication)
# ---------------------------------------------------------------------------


@pytest.mark.asyncio
async def test_repeat_generation_upserts_in_place_without_duplicating() -> None:
    llm = _SpyLLM()
    repo: InMemoryRepository[WatchItem] = InMemoryRepository("watchitems")
    bus = _CapturingBus()
    use_case = WatchlistUseCase(llm=llm, watchitems=repo, bus=bus)
    profile = _make_persona("persona_dedup")

    await use_case.generate_for_persona(profile)
    first_ids = {i.id for i in await repo.list(filter={"persona_id": "persona_dedup"})}

    await use_case.generate_for_persona(profile)
    second_ids = {i.id for i in await repo.list(filter={"persona_id": "persona_dedup"})}

    assert first_ids == second_ids
    assert len(second_ids) == EXPECTED_ITEMS
    # Ids are the documented deterministic pattern: watch_{pid}_{idx}.
    assert second_ids == {
        "watch_persona_dedup_0",
        "watch_persona_dedup_1",
        "watch_persona_dedup_2",
    }


# ---------------------------------------------------------------------------
# 3. Handler integration via the real AsyncioEventBus
# ---------------------------------------------------------------------------


@pytest.mark.asyncio
async def test_handler_integration_on_persona_persisted() -> None:
    bus = AsyncioEventBus()
    repo: InMemoryRepository[WatchItem] = InMemoryRepository("watchitems")
    llm = _SpyLLM()

    use_case = WatchlistUseCase(llm=llm, watchitems=repo, bus=bus)
    register_handler(bus, use_case)

    # Capture any WatchlistReady the handler chain publishes.
    captured: list[WatchlistReady] = []

    async def capture(event: Any) -> None:
        if isinstance(event, WatchlistReady):
            captured.append(event)

    bus.subscribe(WatchlistReady.NAME, capture)

    profile = _make_persona("persona_integration")
    await bus.publish(PersonaPersisted(profile=profile))

    # Items in repo.
    stored = await repo.list(filter={"persona_id": "persona_integration"})
    assert len(stored) == EXPECTED_ITEMS
    # WatchlistReady fired once.
    assert len(captured) == 1
    assert captured[0].persona_id == "persona_integration"


# ---------------------------------------------------------------------------
# 4. Garbage LLM response → retry once → silent failure
# ---------------------------------------------------------------------------


@pytest.mark.asyncio
async def test_garbage_llm_retries_once_then_fails_silently() -> None:
    llm = _SpyLLM(responses=["not json at all", "{still not valid json"])
    repo: InMemoryRepository[WatchItem] = InMemoryRepository("watchitems")
    bus = _CapturingBus()
    use_case = WatchlistUseCase(llm=llm, watchitems=repo, bus=bus)

    items = await use_case.generate_for_persona(_make_persona("persona_garbage"))

    # No items, no event, exactly two LLM calls (first attempt + one retry).
    assert items == []
    assert not any(isinstance(e, WatchlistReady) for e in bus.published)
    assert llm.complete_calls == EXPECTED_LLM_CALLS_RETRY


# ---------------------------------------------------------------------------
# 5. ANTI-HARDCODING GUARD — the headline F8 test
# ---------------------------------------------------------------------------


@pytest.mark.asyncio
async def test_anti_hardcoding_llm_complete_must_be_called() -> None:
    """F8 is the top-cited anti-pattern in CLAUDE.md §8: 'do NOT hardcode
    the watchlist for demo purposes'. This test asserts the use case reaches
    the LLM port on every generation — no future refactor can silently swap
    in static fixtures without failing this check."""
    llm = _SpyLLM()
    repo: InMemoryRepository[WatchItem] = InMemoryRepository("watchitems")
    bus = _CapturingBus()
    use_case = WatchlistUseCase(llm=llm, watchitems=repo, bus=bus)

    await use_case.generate_for_persona(_make_persona("persona_antihc"))

    assert llm.complete_calls >= EXPECTED_LLM_CALLS_HAPPY
    # The system prompt we sent was Prompt 4 from features/watchlist/prompts.py,
    # not some bypassed template.
    assert llm.last_system is not None
    assert "watchlist generator" in llm.last_system.lower()


# ---------------------------------------------------------------------------
# 6. GET /api/watchlist returns persisted items
# ---------------------------------------------------------------------------


def test_get_watchlist_returns_persisted_items_via_http() -> None:
    app = FastAPI()
    bus = AsyncioEventBus()
    repo: InMemoryRepository[WatchItem] = InMemoryRepository("watchitems")
    llm = _SpyLLM()
    wire(app, bus=bus, llm=llm, watchitems=repo)

    async def seed() -> None:
        use_case = WatchlistUseCase(llm=llm, watchitems=repo, bus=bus)
        await use_case.generate_for_persona(_make_persona("persona_http"))

    asyncio.new_event_loop().run_until_complete(seed())

    client = TestClient(app)
    resp = client.get("/api/watchlist", params={"persona_id": "persona_http"})
    assert resp.status_code == HTTP_OK
    payload = resp.json()
    assert len(payload) == EXPECTED_ITEMS
    first = payload[0]
    assert set(first) >= {
        "id",
        "persona_id",
        "topic",
        "why_it_matters",
        "current_status",
        "next_milestone",
        "urgency",
        "action_if_passes",
    }
    assert first["persona_id"] == "persona_http"


