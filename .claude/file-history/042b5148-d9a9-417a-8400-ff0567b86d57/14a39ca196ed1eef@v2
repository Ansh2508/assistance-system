/**
 * useMedia — public hook for the F7 Media Analysis feature.
 *
 * Flow:
 *   1. Subscribe to "card.selected" on the bus → on tap, fetch /api/media/{id}
 *   2. Subscribe to "media.analyzed" on the bus → when the backend handler
 *      re-fires (e.g. on rehydration), re-fetch the same policy_id to pick
 *      up any cache updates.
 *   3. Track loading/error/analysis in local state. Returns the current
 *      policy_id so the component can render "nothing selected" vs loaded.
 *
 * Vanilla useState/useEffect per the established FE convention — no
 * TanStack Query in day-1.
 */

import { useEffect, useState } from "react";

import { ApiError } from "@shared/api";

import { fetchMedia, type MediaAnalysis } from "../api";
import { subscribeCardSelected, subscribeMediaAnalyzed } from "../events";

export interface UseMediaState {
  policyId: string | null;
  analysis: MediaAnalysis | null;
  loading: boolean;
  error: string | null;
}

export function useMedia(): UseMediaState {
  const [policyId, setPolicyId] = useState<string | null>(null);
  const [analysis, setAnalysis] = useState<MediaAnalysis | null>(null);
  const [loading, setLoading] = useState<boolean>(false);
  const [error, setError] = useState<string | null>(null);

  // Track a load generation so late responses can't clobber fresh state.
  const [loadToken, setLoadToken] = useState<number>(0);

  // Respond to card taps.
  useEffect(() => {
    return subscribeCardSelected((pid) => {
      setPolicyId(pid);
      setLoadToken((n) => n + 1);
    });
  }, []);

  // Respond to backend rehydration events.
  useEffect(() => {
    return subscribeMediaAnalyzed((pid) => {
      // Only reload if this matches the currently-displayed policy.
      setPolicyId((current) => {
        if (current === pid) setLoadToken((n) => n + 1);
        return current;
      });
    });
  }, []);

  // Do the actual fetch whenever (policyId, loadToken) changes.
  useEffect(() => {
    if (policyId === null) {
      setAnalysis(null);
      setLoading(false);
      setError(null);
      return;
    }

    let cancelled = false;
    setLoading(true);
    setError(null);

    fetchMedia(policyId)
      .then((data) => {
        if (cancelled) return;
        setAnalysis(data);
        setLoading(false);
      })
      .catch((err: unknown) => {
        if (cancelled) return;
        const message =
          err instanceof ApiError
            ? `media ${err.status}`
            : err instanceof Error
              ? err.message
              : "media fetch failed";
        setError(message);
        setLoading(false);
      });

    return () => {
      cancelled = true;
    };
  }, [policyId, loadToken]);

  return { policyId, analysis, loading, error };
}
