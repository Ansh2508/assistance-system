class CountingFakeLLM:
    """Fake LLMPort that counts invocations and returns a programmable response.

    `responses` is a queue of strings; the Nth call returns responses[N-1]. Once
    exhausted, subsequent calls return responses[-1] (stable tail).
    """

    def __init__(self, responses: list[str]) -> None:
        assert responses, "CountingFakeLLM needs at least one response"
        self._responses = responses
        self.call_count = 0

    async def complete(self, **_: object) -> str:
        self.call_count += 1
        idx = min(self.call_count - 1, len(self._responses) - 1)
        return self._responses[idx]

    def stream(self, **_: object) -> AsyncIterator[str]:  # pragma: no cover — unused
        raise NotImplementedError


def _build_use_case(
    fake_llm: CountingFakeLLM,
    *,
    personas: InMemoryRepository[PersonaProfile] | None = None,
    watchitems: InMemoryRepository[WatchItem] | None = None,
    bus: AsyncioEventBus | None = None,
) -> tuple[
    WatchlistUseCase,
    InMemoryRepository[PersonaProfile],
    InMemoryRepository[WatchItem],
    AsyncioEventBus,
]:
    personas = personas or InMemoryRepository[PersonaProfile]("personas")
    watchitems = watchitems or InMemoryRepository[WatchItem]("watchitems")
    bus = bus or AsyncioEventBus()
    uc = WatchlistUseCase(
        llm=fake_llm,
        watchitems=watchitems,
        personas=personas,
        bus=bus,
    )
    return uc, personas, watchitems, bus


async def _subscribe_watchlist_ready(bus: AsyncioEventBus) -> list[WatchlistReady]:
    captured: list[WatchlistReady] = []

    async def handler(event: object) -> None:
        assert isinstance(event, WatchlistReady)
        captured.append(event)

    bus.subscribe(WatchlistReady.NAME, handler)
    return captured


# -------------------------------------------------------------------- 1. prompts


def test_prompts_render_with_persona_json() -> None:
    persona = _make_persona()
    rendered = WATCHLIST_USER_TEMPLATE.format(persona_json=persona.model_dump_json())
    # Fields that the prompt promises to show the LLM — guard against template drift.
    assert "Maria" in rendered
    assert "München" in rendered
    assert "Wohngeld" in rendered
    assert "rent" in rendered
    assert '"language":"de"' in rendered


# -------------------------------------------- 2. anti-hardcoding (the headline)


async def test_handler_calls_llm_and_marker_survives_round_trip() -> None:
    """Non-negotiable: handler must actually drive persisted data from LLM output.

    Fails if a future refactor either (a) skips LLMPort.complete() entirely or
    (b) calls it and discards the response.
    """
    fake = CountingFakeLLM([_canned_items_json()])
    uc, personas, watchitems, _ = _build_use_case(fake)
    await personas.upsert(_make_persona())

    await uc.generate_for_persona("persona_maria")

    # Loophole A: skip the LLM.
    assert fake.call_count >= 1, (
        "F8 anti-hardcoding: LLMPort.complete() was never called. "
        "Rule: the handler must not short-circuit the LLM for any reason."
    )

    # Loophole B: call the LLM, ignore the response.
    stored = await watchitems.list(filter={"persona_id": "persona_maria"})
    assert len(stored) == EXPECTED_ITEMS
    assert all(MARKER in item.topic for item in stored), (
        "F8 anti-hardcoding: the LLM response did not flow into persisted items. "
        "The marker threaded through the fake response was lost — something is "
        "replacing LLM output with hardcoded data."
    )


# ------------------------------------------------ 3. full persistence shape


async def test_handler_persists_three_items_with_all_six_fields() -> None:
    fake = CountingFakeLLM([_canned_items_json()])
    uc, personas, watchitems, _ = _build_use_case(fake)
    await personas.upsert(_make_persona())

    await uc.generate_for_persona("persona_maria")

    items = await watchitems.list(filter={"persona_id": "persona_maria"})
    assert len(items) == EXPECTED_ITEMS
    for item in items:
        assert item.topic
        assert item.why_it_matters
        assert item.current_status
        assert item.next_milestone
        assert item.urgency in {"low", "medium", "high"}
        assert item.action_if_passes
        assert item.persona_id == "persona_maria"


# ------------------------------------------------ 4. retry-once on invalid JSON


async def test_handler_retries_once_on_invalid_json() -> None:
    fake = CountingFakeLLM(["not-json-at-all", _canned_items_json()])
    uc, personas, watchitems, _ = _build_use_case(fake)
    await personas.upsert(_make_persona())

    await uc.generate_for_persona("persona_maria")

    assert fake.call_count == RETRY_CALL_COUNT, "expected retry once after invalid JSON"
    stored = await watchitems.list(filter={"persona_id": "persona_maria"})
    assert len(stored) == EXPECTED_ITEMS


# --------------------------------------- 5. soft-fail on double-invalid JSON


async def test_handler_soft_fails_on_double_invalid_json() -> None:
    fake = CountingFakeLLM(["still-not-json", "also-not-json"])
    uc, personas, watchitems, bus = _build_use_case(fake)
    captured = await _subscribe_watchlist_ready(bus)
    await personas.upsert(_make_persona())

    # Must not raise. The persona_builder handler that fired us must not crash.
    await uc.generate_for_persona("persona_maria")

    assert fake.call_count == RETRY_CALL_COUNT
    stored = await watchitems.list(filter={"persona_id": "persona_maria"})
    assert stored == []
    assert len(captured) == 1
    assert captured[0].persona_id == "persona_maria"
    assert captured[0].items == []


# -------------------------------------------------- 6. overwrite on re-run


async def test_handler_overwrites_stale_items_on_rerun() -> None:
    fake = CountingFakeLLM([_canned_items_json(), _canned_items_json("__RERUN__")])
    uc, personas, watchitems, _ = _build_use_case(fake)
    await personas.upsert(_make_persona())

    await uc.generate_for_persona("persona_maria")
    first_pass = await watchitems.list(filter={"persona_id": "persona_maria"})
    assert len(first_pass) == EXPECTED_ITEMS

    await uc.generate_for_persona("persona_maria")
    second_pass = await watchitems.list(filter={"persona_id": "persona_maria"})
    assert len(second_pass) == EXPECTED_ITEMS, (
        "overwrite failed — stale items should be deleted before upsert, "
        "otherwise deterministic-id changes (via created_at) cause fan-out"
    )
    assert all("__RERUN__" in item.topic for item in second_pass)


# ------------------------------------------------- 7. read path is pure


async def test_get_watchlist_returns_cached_without_llm_call() -> None:
    fake = CountingFakeLLM([_canned_items_json()])
    uc, personas, _, _ = _build_use_case(fake)
    await personas.upsert(_make_persona())

    await uc.generate_for_persona("persona_maria")
    baseline = fake.call_count
    assert baseline == 1

    for _ in range(5):
        items = await uc.list_for_persona("persona_maria")
        assert len(items) == EXPECTED_ITEMS

    assert fake.call_count == baseline, "GET path must never call the LLM"


# ----------------------------------------------- 8. unknown persona is empty


async def test_list_for_unknown_persona_returns_empty() -> None:
    fake = CountingFakeLLM([_canned_items_json()])
    uc, _, _, _ = _build_use_case(fake)

    items = await uc.list_for_persona("persona_does_not_exist")
    assert items == []
    assert fake.call_count == 0


# ----------------------------------------- 9. deterministic id (same input → same id)


def test_watchitem_id_deterministic() -> None:
    ts = datetime(2026, 4, 12, 10, 0, 0, tzinfo=UTC)
    a = _deterministic_id("persona_maria", "Mietendeckel vote", ts)
    b = _deterministic_id("persona_maria", "Mietendeckel vote", ts)
    c = _deterministic_id("persona_maria", "Kindergrundsicherung rollout", ts)
    assert a == b, "same input → same id"
    assert a != c, "different topic → different id"
    assert a.startswith("watch_")


# ------------------------------------- bonus: handler is soft-fail on missing persona


async def test_handler_soft_fails_when_persona_not_in_repo() -> None:
    """Guard the defensive pattern: event is notification, repo is source of truth."""
    fake = CountingFakeLLM([_canned_items_json()])
    uc, _, watchitems, bus = _build_use_case(fake)
    captured = await _subscribe_watchlist_ready(bus)

    await uc.generate_for_persona("persona_ghost")

    assert fake.call_count == 0, "no LLM call when persona is missing"
    stored = await watchitems.list(filter={"persona_id": "persona_ghost"})
    assert stored == []
    assert len(captured) == 1
    assert captured[0].items == []


