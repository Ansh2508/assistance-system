"""F8 · Watchlist — acceptance suite.

Scope (docs/07-roadmap.md §8.8):
  1. Prompts render with persona fields present (regression guard).
  2. Handler calls LLMPort AND the marker from the fake response survives
     into the stored WatchItem — this is the non-negotiable anti-hardcoding
     test (CLAUDE.md §8). Closes two cheating loopholes:
        (a) skip the LLM entirely → fails on call_count assertion
        (b) call the LLM but ignore the response → fails on marker assertion
  3. Three items persisted, every one with all six content fields non-empty.
  4. Invalid JSON once → retry → second success → call_count == 2.
  5. Invalid JSON twice → soft-fail: no items, empty WatchlistReady, no raise.
  6. Stale items are deleted before upsert on re-run (no 6-item fan-out).
  7. GET path never calls the LLM (repo IS the cache).
  8. Unknown persona → GET returns [] (no 404).
  9. Deterministic id: same (persona, topic, created_at) → same sha1-derived id.

No mocked infrastructure: real InMemoryRepository, real AsyncioEventBus.
Only the LLMPort is faked.
"""

from __future__ import annotations

import json
from collections.abc import AsyncIterator
from datetime import UTC, datetime

import pytest

from clara.core.domain.persona import PersonaProfile
from clara.core.domain.watch import WatchItem
from clara.core.events.catalog import WatchlistReady
from clara.features.watchlist.prompts import WATCHLIST_USER_TEMPLATE
from clara.features.watchlist.use_case import WatchlistUseCase, _deterministic_id
from clara.infrastructure.bus.asyncio_bus import AsyncioEventBus
from clara.infrastructure.repository.memory import InMemoryRepository

# Marker threaded through the fake LLM response into persisted items. Any future
# refactor that either (a) bypasses the LLM or (b) calls it and discards the
# response will be unable to produce this string organically. Both loopholes
# fail the same test body.
MARKER = "__F8_MARKER_7f3a__"

# Prompt contract constants (docs/07-roadmap.md §8.8): exactly 3 items per run.
EXPECTED_ITEMS = 3
# Retry budget in WatchlistUseCase._invoke_llm_with_retry: 1 retry → 2 calls max.
RETRY_CALL_COUNT = 2


