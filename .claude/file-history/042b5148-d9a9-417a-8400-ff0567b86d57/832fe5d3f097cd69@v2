/**
 * useFeed — public hook for the F3 Feed feature.
 *
 * Fetches GET /api/feed on mount and whenever personaId changes. Re-fetches
 * when subscribeFeedGenerated fires (will light up once shared/sse wires
 * backend `feed.generated` into the FE bus). Returns a tuple of display
 * state + an imperative selectCard action.
 *
 * Follows the vanilla useState/useEffect pattern established by F8
 * Watchlist — no TanStack Query in the day-1 FE per existing convention.
 */

import { useCallback, useEffect, useState } from "react";

import { ApiError } from "@shared/api";

import { fetchFeed, type FeedCard } from "../api";
import { emitCardSelected, subscribeFeedGenerated } from "../events";
import { useFeedStore } from "./store";

export interface UseFeedState {
  cards: FeedCard[];
  selectedPolicyId: string | null;
  loading: boolean;
  error: string | null;
  selectCard: (personaId: string, policyId: string) => void;
  reload: () => void;
}

export function useFeed(personaId: string | null): UseFeedState {
  const { cards, selectedPolicyId, status, error, _setLoading, _setReady, _setError, selectCard: storeSelect, reset } =
    useFeedStore();

  const [refreshToken, setRefreshToken] = useState<number>(0);

  const reload = useCallback(() => {
    setRefreshToken((n) => n + 1);
  }, []);

  useEffect(() => {
    if (personaId === null) {
      reset();
      return;
    }

    let cancelled = false;
    _setLoading(personaId);

    fetchFeed(personaId)
      .then((data) => {
        if (cancelled) return;
        _setReady(data);
      })
      .catch((err: unknown) => {
        if (cancelled) return;
        const message =
          err instanceof ApiError
            ? `feed ${err.status}`
            : err instanceof Error
              ? err.message
              : "feed fetch failed";
        _setError(message);
      });

    const unsub = subscribeFeedGenerated(personaId, reload);

    return () => {
      cancelled = true;
      unsub();
    };
  }, [personaId, refreshToken, reload, _setLoading, _setReady, _setError, reset]);

  const selectCard = useCallback(
    (pid: string, policyId: string) => {
      storeSelect(policyId);
      emitCardSelected(pid, policyId);
    },
    [storeSelect],
  );

  return {
    cards,
    selectedPolicyId,
    loading: status === "loading",
    error,
    selectCard,
    reload,
  };
}
