/**
 * Global test setup — runs before every test file.
 *
 * Registers the jest-dom custom matchers (`toBeInTheDocument`,
 * `toHaveClass`, etc.) on vitest's `expect`. Also installs a permissive
 * `matchMedia` shim so components that feature-detect via media queries
 * don't throw in jsdom.
 */

import "@testing-library/jest-dom/vitest";
import { afterEach } from "vitest";
import { cleanup } from "@testing-library/react";

// React Testing Library auto-cleanup after each test (unmounts components
// so their effects release any bus subscriptions).
afterEach(() => {
  cleanup();
});

// jsdom doesn't implement matchMedia — some Tailwind utilities (e.g. dark
// mode detection) call it at mount time. A no-op shim prevents crashes.
if (typeof window !== "undefined" && typeof window.matchMedia !== "function") {
  Object.defineProperty(window, "matchMedia", {
    writable: true,
    value: (query: string) => ({
      matches: false,
      media: query,
      onchange: null,
      addListener: () => {},
      removeListener: () => {},
      addEventListener: () => {},
      removeEventListener: () => {},
      dispatchEvent: () => false,
    }),
  });
}
