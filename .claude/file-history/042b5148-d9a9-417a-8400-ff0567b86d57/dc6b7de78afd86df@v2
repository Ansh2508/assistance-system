/**
 * FeedGrid — the F3 Feed slice's main UI surface.
 *
 * Renders up to 3 PolicyCards in a responsive grid. Display states:
 *   - personaId is null           → nothing (dashboard hasn't resolved yet)
 *   - loading + no cached cards   → 3 skeleton rows
 *   - error                       → inline non-blocking error + retry
 *   - ready, 0 cards              → "no cards yet" informational row
 *   - ready, >0 cards             → grid of PolicyCard
 *
 * Selection is lifted to useFeed.selectCard, which both updates the store
 * and emits `card.selected` on the FE bus so F4/F7 react without importing
 * this feature.
 */

import { cn } from "@shared/lib";

import { useFeed } from "../model/useFeed";
import { PolicyCard } from "./PolicyCard";

interface Props {
  personaId: string | null;
}

export function FeedGrid({ personaId }: Props) {
  const { cards, selectedPolicyId, loading, error, selectCard, reload } =
    useFeed(personaId);

  if (personaId === null) return null;

  return (
    <section aria-labelledby="feed-heading" className="flex flex-col gap-4">
      <header className="flex items-baseline justify-between">
        <h2
          id="feed-heading"
          className="font-mono text-xs uppercase tracking-widest text-clara-muted"
        >
          Your briefing
        </h2>
        {loading && (
          <span className="font-mono text-[10px] text-clara-muted">
            loading…
          </span>
        )}
      </header>

      {error !== null && (
        <div className="flex items-center justify-between gap-3 rounded-card border border-clara-danger/40 bg-clara-danger/10 p-3">
          <p role="alert" className="text-xs text-clara-danger">
            {error}
          </p>
          <button
            type="button"
            onClick={reload}
            className={cn(
              "rounded-card border border-clara-danger/40 px-2 py-1",
              "font-mono text-[10px] uppercase tracking-wider",
              "text-clara-danger transition hover:bg-clara-danger/20",
              "focus:outline-none focus-visible:ring-2 focus-visible:ring-clara-danger",
            )}
          >
            Retry
          </button>
        </div>
      )}

      {loading && cards.length === 0 && (
        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {[0, 1, 2].map((i) => (
            <div
              key={i}
              aria-hidden="true"
              className={cn(
                "h-44 animate-pulse rounded-card",
                "border border-clara-border bg-clara-surface/60",
              )}
            />
          ))}
        </div>
      )}

      {!loading && cards.length === 0 && error === null && (
        <p className="text-sm text-clara-muted">
          No cards yet. They appear after your persona is built.
        </p>
      )}

      {cards.length > 0 && (
        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map((card) => (
            <PolicyCard
              key={card.policy_id}
              card={card}
              selected={card.policy_id === selectedPolicyId}
              onSelect={(pid) => selectCard(personaId, pid)}
            />
          ))}
        </div>
      )}
    </section>
  );
}
