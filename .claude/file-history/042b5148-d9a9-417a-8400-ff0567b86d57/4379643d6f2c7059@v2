/**
 * Zustand slice for the F3 Feed feature.
 *
 * State machine: idle → loading → ready
 *                                → error
 *
 * idle    — no persona resolved yet (or persona cleared)
 * loading — GET /api/feed in-flight for the current persona
 * ready   — cards received and stored
 * error   — fetch failed (network or 5xx)
 *
 * The selected card id is also tracked here so PolicyCard can render an
 * active state without the parent needing to thread selection state through.
 */

import { create } from "zustand";

import type { FeedCard } from "../api";

export type FeedStatus = "idle" | "loading" | "ready" | "error";

type FeedState = {
  status: FeedStatus;
  personaId: string | null;
  cards: FeedCard[];
  selectedPolicyId: string | null;
  error: string | null;
};

type FeedActions = {
  /** Transition to "loading" and clear any stale cards. */
  _setLoading: (personaId: string) => void;
  /** Transition to "ready" and store the fetched cards. */
  _setReady: (cards: FeedCard[]) => void;
  /** Transition to "error" and retain the last personaId for retry. */
  _setError: (message: string) => void;
  /** Mark a card as selected (source of truth for the main panel). */
  selectCard: (policyId: string) => void;
  /** Hard reset — e.g. user logs out or onboarding re-runs. */
  reset: () => void;
};

export type FeedStore = FeedState & FeedActions;

export const useFeedStore = create<FeedStore>((set) => ({
  status: "idle",
  personaId: null,
  cards: [],
  selectedPolicyId: null,
  error: null,

  _setLoading: (personaId) =>
    set({
      status: "loading",
      personaId,
      cards: [],
      error: null,
    }),

  _setReady: (cards) => set({ status: "ready", cards, error: null }),

  _setError: (error) => set({ status: "error", error }),

  selectCard: (policyId) => set({ selectedPolicyId: policyId }),

  reset: () =>
    set({
      status: "idle",
      personaId: null,
      cards: [],
      selectedPolicyId: null,
      error: null,
    }),
}));
