/**
 * PolicyCard — one card in the F3 Feed grid.
 *
 * Displays:
 *   - Source name (small monospace, muted)
 *   - Urgency pill (strictly within the locked `clara-*` palette per
 *     docs/01-strategy.md §9 — no off-brand colors)
 *   - Title (the headline claim)
 *   - Preview (first 120 chars of raw policy text)
 *   - Relevance bar (thin accent-colored bar under the header)
 *
 * Selection state lifts to the parent via `onSelect`. When `selected=true`
 * the card gains a ring in the accent color — this is the only difference
 * between the idle and focused states so the grid stays readable on mobile.
 */

import { cn } from "@shared/lib";

import type { FeedCard, Urgency } from "../api";

interface Props {
  card: FeedCard;
  selected: boolean;
  onSelect: (policyId: string) => void;
}

const URGENCY_TOKENS: Record<Urgency, { label: string; className: string }> = {
  low: {
    label: "LOW",
    className: "text-clara-muted ring-1 ring-clara-border bg-clara-bg/40",
  },
  medium: {
    label: "MEDIUM",
    className:
      "text-clara-warning ring-1 ring-clara-warning/40 bg-clara-warning/10",
  },
  high: {
    label: "HIGH",
    className:
      "text-clara-warning ring-1 ring-clara-warning/70 bg-clara-warning/20",
  },
};

export function PolicyCard({ card, selected, onSelect }: Props) {
  const urgency = URGENCY_TOKENS[card.urgency];
  const relevancePct = Math.round(
    Math.max(0, Math.min(1, card.relevance_score)) * 100,
  );

  return (
    <button
      type="button"
      onClick={() => onSelect(card.policy_id)}
      aria-pressed={selected}
      aria-label={`Select policy: ${card.title}`}
      className={cn(
        "group flex w-full flex-col gap-3 rounded-card border p-5 text-left",
        "border-clara-border bg-clara-surface transition-all duration-150",
        "hover:border-clara-accent/60 hover:bg-clara-surface/80",
        "focus:outline-none focus-visible:ring-2 focus-visible:ring-clara-accent",
        "focus-visible:ring-offset-2 focus-visible:ring-offset-clara-bg",
        selected && "border-clara-accent ring-1 ring-clara-accent",
      )}
    >
      <header className="flex items-center justify-between gap-3">
        <span className="font-mono text-[10px] uppercase tracking-widest text-clara-muted">
          {card.source_name}
        </span>
        <span
          className={cn(
            "rounded-full px-2 py-0.5 font-mono text-[10px] tracking-wider",
            urgency.className,
          )}
        >
          {urgency.label}
        </span>
      </header>

      <h3 className="text-base font-semibold leading-snug text-clara-text">
        {card.title}
      </h3>

      <p className="line-clamp-3 text-sm text-clara-muted">{card.preview}</p>

      <footer className="mt-1 flex items-center gap-3">
        <div
          role="progressbar"
          aria-label="Relevance"
          aria-valuenow={relevancePct}
          aria-valuemin={0}
          aria-valuemax={100}
          className="h-0.5 flex-1 overflow-hidden rounded-full bg-clara-border"
        >
          <div
            className="h-full rounded-full bg-clara-accent transition-all duration-300"
            style={{ width: `${String(relevancePct)}%` }}
          />
        </div>
        <span className="font-mono text-[10px] text-clara-muted">
          {relevancePct}% match
        </span>
      </footer>
    </button>
  );
}
