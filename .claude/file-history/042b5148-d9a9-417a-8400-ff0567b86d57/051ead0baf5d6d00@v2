"""F8 Watchlist — internal schemas.

``WatchlistLLMResponse`` is the Pydantic boundary guard for the raw JSON
returned by the LLM. It is deliberately separate from ``WatchItem`` (which
lives in the contracts package) because the LLM may emit slightly different
shapes; we validate loose input here, then map explicitly to the contract
type before persisting. Mirrors the F2 persona_builder pattern.
"""

from __future__ import annotations

from typing import Literal

from pydantic import BaseModel, ConfigDict, Field

Urgency = Literal["low", "medium", "high"]


class WatchItemLLMResponse(BaseModel):
    """One watchlist item as returned by the LLM, before mapping to the contract type."""

    model_config = ConfigDict(frozen=True, extra="ignore")

    topic: str = Field(min_length=3, max_length=200)
    why_it_matters: str = Field(min_length=5, max_length=400)
    current_status: str = Field(min_length=3, max_length=400)
    next_milestone: str = Field(min_length=3, max_length=200)
    urgency: Urgency = "medium"
    action_if_passes: str = Field(min_length=5, max_length=400)


class WatchlistLLMResponse(BaseModel):
    """Top-level LLM response: exactly 3 items (Prompt 4 invariant)."""

    model_config = ConfigDict(frozen=True, extra="ignore")

    items: list[WatchItemLLMResponse] = Field(min_length=1, max_length=5)
