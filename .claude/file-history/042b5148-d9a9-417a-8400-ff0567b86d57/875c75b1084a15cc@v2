/**
 * Server-Sent Events client — opens a persistent stream to `/api/events` and
 * fans incoming backend events onto the FE bus.
 *
 * This module is the SINGLE bridge between backend events (flowing through
 * FastAPI's `/api/events` SSE endpoint, hosted by features/feed per
 * docs/07-roadmap.md §5.2) and the FE TypedBus in `shared/bus`. No feature
 * opens an EventSource directly — every feature subscribes to the bus and
 * this client decides when and how those events arrive.
 *
 * Mapping (backend name → FE bus payload):
 *   briefing.generated → briefing.ready
 *   voice.ready        → voice.ready
 *   citations.resolved → citations.resolved
 *   media.analyzed     → media.analyzed
 *   watchlist.ready    → watchlist.ready
 *   feed.generated     → (not on the FE bus; dropped — the feed hook
 *                         re-fetches via HTTP on its own schedule)
 *
 * Notes on schema drift:
 *   - The backend events carry snake_case field names (persona_id, policy_id,
 *     source_url, ...). The FE bus uses camelCase (personaId, policyId, ...).
 *     Every mapping in this file is explicit so that a backend schema change
 *     will cause a TypeScript error here instead of silently breaking the FE.
 *   - Heartbeat frames (lines starting with `:`) are ignored by the EventSource
 *     spec itself — nothing to do here.
 *
 * Lifecycle: `openSseStream(personaId)` returns a close() handle the caller
 * must invoke on unmount / persona change. Reconnection is handled by the
 * browser's native EventSource (it retries on its own every ~3s by default).
 */

import { bus, type ClaraEvents, type Span } from "@shared/bus";

/** Thin shape of the backend BriefingGenerated payload. */
interface BackendBriefing {
  id: string;
  persona_id?: string;
  policy_id?: string;
  opening: string;
  paragraphs: Array<{
    text: string;
    cited_spans: string[];
  }>;
}

interface BackendBriefingGenerated {
  briefing: BackendBriefing;
}

interface BackendVoiceReady {
  briefing_id: string;
  audio_url: string;
}

interface BackendCitationsResolved {
  briefing_id: string;
  resolved: Array<{
    id?: string;
    span: { span_id: string; surface: string };
    resolved_text: string;
  }>;
}

interface BackendMediaAnalysis {
  policy_id: string;
  official_framing: string;
  media_focus: string;
  hidden_impact: string;
  watch_out_for: string;
}

interface BackendMediaAnalyzed {
  policy_id: string;
  analysis: BackendMediaAnalysis;
}

interface BackendWatchlistReady {
  persona_id: string;
  items: Array<{
    id: string;
    topic: string;
    next_milestone: string;
    urgency: "low" | "medium" | "high";
  }>;
}

/**
 * All backend events the client knows how to translate, keyed by the
 * backend's wire event name. The handlers each push onto the FE bus.
 */
const BACKEND_HANDLERS: Record<string, (data: unknown) => void> = {
  "briefing.generated": (data) => {
    const payload = data as BackendBriefingGenerated;
    const briefing = payload.briefing;
    const spans: Span[] = briefing.paragraphs
      .flatMap((p) => p.cited_spans)
      .map((id) => ({ spanId: id, surface: id }));

    bus.emit("briefing.ready", {
      briefingId: briefing.id,
      text: briefing.opening,
      spans,
    });
  },

  "voice.ready": (data) => {
    const payload = data as BackendVoiceReady;
    bus.emit("voice.ready", {
      briefingId: payload.briefing_id,
      audioUrl: payload.audio_url,
    });
  },

  "citations.resolved": (data) => {
    const payload = data as BackendCitationsResolved;
    const resolved: Record<string, string> = {};
    for (const entry of payload.resolved) {
      resolved[entry.span.span_id] = entry.resolved_text;
    }
    bus.emit("citations.resolved", {
      briefingId: payload.briefing_id,
      resolved,
    });
  },

  "media.analyzed": (data) => {
    const payload = data as BackendMediaAnalyzed;
    const analysis: ClaraEvents["media.analyzed"]["analysis"] = {
      policyId: payload.analysis.policy_id,
      officialFraming: payload.analysis.official_framing,
      mediaFocus: payload.analysis.media_focus,
      hiddenImpact: payload.analysis.hidden_impact,
      watchOutFor: payload.analysis.watch_out_for,
    };
    bus.emit("media.analyzed", {
      policyId: payload.policy_id,
      analysis,
    });
  },

  "watchlist.ready": (data) => {
    const payload = data as BackendWatchlistReady;
    bus.emit("watchlist.ready", {
      personaId: payload.persona_id,
      items: payload.items.map((it) => ({
        id: it.id,
        topic: it.topic,
        nextMilestone: it.next_milestone,
        urgency: it.urgency,
      })),
    });
  },

  // feed.generated is intentionally a no-op — the feed hook re-fetches
  // via HTTP on its own schedule and never reads from the FE bus.
  "feed.generated": () => {
    /* intentional no-op */
  },
};

export interface SseConnection {
  readonly close: () => void;
  readonly source: EventSource;
}

const BASE: string = import.meta.env.VITE_API_BASE_URL ?? "/api";

/**
 * Open an SSE connection scoped to a persona. The caller MUST call
 * `.close()` on the returned handle when the component unmounts or the
 * persona changes — leaving connections open will exhaust the browser's
 * concurrent-connection pool (6 per origin on most browsers).
 */
export function openSseStream(personaId: string): SseConnection {
  const url = `${BASE}/events?persona_id=${encodeURIComponent(personaId)}`;
  const source = new EventSource(url);

  for (const [eventName, handler] of Object.entries(BACKEND_HANDLERS)) {
    source.addEventListener(eventName, (evt: MessageEvent<string>) => {
      try {
        const data: unknown = JSON.parse(evt.data);
        handler(data);
      } catch {
        // Malformed frames are dropped silently — a single bad frame must
        // not tear down the whole stream. Real failures surface as
        // `onerror` and the browser auto-reconnects.
      }
    });
  }

  return {
    source,
    close: () => source.close(),
  };
}
