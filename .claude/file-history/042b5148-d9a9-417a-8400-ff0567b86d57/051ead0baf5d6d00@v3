"""Feature-local DTOs — the contract between the LLM and the watchlist use-case.

These are NOT in packages/contracts. They describe the shape the LLM must
emit as JSON, and they are the parsing boundary that turns untrusted model
output into a typed value. The *persisted* domain type is
`clara.core.domain.watch.WatchItem`; this DTO is an ephemeral parse target.

extra="forbid" is load-bearing: it fails parse on any stray key, which stops
the LLM from smuggling arbitrary fields into the repo.
"""

from __future__ import annotations

from clara_contracts.policy import Urgency
from pydantic import BaseModel, ConfigDict, Field


class LlmWatchItem(BaseModel):
    """One item as emitted by the LLM. Strict: no extra fields, no empty strings."""

    model_config = ConfigDict(extra="forbid", frozen=True)

    topic: str = Field(min_length=1)
    why_it_matters: str = Field(min_length=1)
    current_status: str = Field(min_length=1)
    next_milestone: str = Field(min_length=1)
    urgency: Urgency = "medium"
    action_if_passes: str = Field(min_length=1)


class LlmWatchlistResponse(BaseModel):
    """Top-level LLM response envelope. Exactly 3 items, no extras."""

    model_config = ConfigDict(extra="forbid", frozen=True)

    items: list[LlmWatchItem] = Field(min_length=3, max_length=3)
