"""F7 · Media Analysis — 'what press says vs what actually matters' panel.

Ports: LLMPort, Repository[Policy] (read-only), EventBus.
Subscribes: card.selected. Publishes: media.analyzed.
HTTP surface: GET /api/media/{policy_id} → MediaAnalysis

Caching is an in-memory dict inside the use case (keyed by policy_id). A
future Repository[MediaAnalysis] swap is a drop-in: change one attribute
and rewire in composition_root — no feature code changes.
"""

from __future__ import annotations

from pathlib import Path

from fastapi import FastAPI

from clara.core.domain.policy import Policy
from clara.core.ports.bus import EventBus
from clara.core.ports.llm import LLMPort
from clara.core.ports.repository import Repository
from clara.features.media_analysis import handler as _handler
from clara.features.media_analysis.router import build_router
from clara.features.media_analysis.use_case import MediaAnalysisUseCase

_SNIPPETS_PATH = Path(__file__).resolve().parents[4] / "seed" / "media_snippets.json"


def wire(
    app: FastAPI,
    *,
    bus: EventBus,
    llm: LLMPort,
    policies: Repository[Policy],
    **_: object,
) -> None:
    use_case = MediaAnalysisUseCase(
        llm=llm,
        policies=policies,
        bus=bus,
        snippets_path=_SNIPPETS_PATH,
    )
    _handler.register(bus, use_case)
    app.include_router(build_router(use_case), prefix="/api", tags=["media"])
