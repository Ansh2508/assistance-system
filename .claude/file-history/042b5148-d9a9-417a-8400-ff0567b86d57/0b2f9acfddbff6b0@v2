/**
 * F7 Media Analysis — FE bus wiring.
 *
 * The media panel is a pure CONSUMER of events — it subscribes to:
 *   - "card.selected": when the user taps a PolicyCard, fetch the analysis
 *   - "media.analyzed": when the backend SSE bridge forwards the
 *     completion signal, re-fetch (handler cache hit → fresh render)
 *
 * It never emits. Per CLAUDE.md §4.8 / §8 the feature must not live-scrape
 * or call out to F4 Translator; the only triggers are the two events above.
 */

import { bus } from "@shared/bus";

export function subscribeCardSelected(
  onSelect: (policyId: string) => void,
): () => void {
  return bus.on("card.selected", ({ policyId }) => {
    onSelect(policyId);
  });
}

export function subscribeMediaAnalyzed(
  onAnalyzed: (policyId: string) => void,
): () => void {
  return bus.on("media.analyzed", ({ policyId }) => {
    onAnalyzed(policyId);
  });
}
