/**
 * MediaPanel — the "what press says vs what actually matters" side panel.
 *
 * Display states:
 *   - no card selected   → hidden (return null)
 *   - loading + no data  → skeleton block
 *   - error              → inline error
 *   - not found          → soft info message
 *   - populated          → 3 paragraphs (official framing, media focus,
 *                          hidden impact), optional deadline alert, amber
 *                          "watch out" line, TrustBadge
 *
 * Uses clara-* palette strictly. No inline styles. No feature imports.
 */

import { cn } from "@shared/lib";

import { useMedia } from "../model/useMedia";
import { TrustBadge } from "./TrustBadge";

export function MediaPanel() {
  const { policyId, analysis, loading, error } = useMedia();

  if (policyId === null) return null;

  return (
    <section
      aria-labelledby="media-heading"
      className="flex flex-col gap-4 rounded-card border border-clara-border bg-clara-surface p-5"
    >
      <header className="flex items-center justify-between gap-3">
        <h2
          id="media-heading"
          className="font-mono text-xs uppercase tracking-widest text-clara-muted"
        >
          Media lens
        </h2>
        {analysis !== null && <TrustBadge level={analysis.trust_level} />}
      </header>

      {loading && analysis === null && (
        <div className="flex animate-pulse flex-col gap-3" aria-hidden="true">
          <div className="h-3 w-3/4 rounded bg-clara-border" />
          <div className="h-3 w-full rounded bg-clara-border" />
          <div className="h-3 w-11/12 rounded bg-clara-border" />
        </div>
      )}

      {error !== null && (
        <p role="alert" className="text-xs text-clara-danger">
          {error}
        </p>
      )}

      {!loading && error === null && analysis === null && (
        <p className="text-sm text-clara-muted">
          No media analysis for this policy yet.
        </p>
      )}

      {analysis !== null && (
        <>
          <Block label="Official framing" body={analysis.official_framing} />
          <Block label="Media focus" body={analysis.media_focus} />
          <Block label="Hidden impact" body={analysis.hidden_impact} />

          {analysis.deadline_alert !== null &&
            analysis.deadline_alert.length > 0 && (
              <div
                className={cn(
                  "rounded-card border border-clara-warning/40",
                  "bg-clara-warning/10 p-3",
                )}
              >
                <p className="font-mono text-[10px] uppercase tracking-widest text-clara-warning">
                  Deadline alert
                </p>
                <p className="mt-1 text-sm text-clara-text">
                  {analysis.deadline_alert}
                </p>
              </div>
            )}

          <p
            className={cn(
              "rounded-card border border-clara-warning/30",
              "bg-clara-warning/5 px-3 py-2 text-xs text-clara-warning",
            )}
          >
            {analysis.watch_out_for}
          </p>
        </>
      )}
    </section>
  );
}

interface BlockProps {
  label: string;
  body: string;
}

function Block({ label, body }: BlockProps) {
  return (
    <div className="flex flex-col gap-1">
      <p className="font-mono text-[10px] uppercase tracking-widest text-clara-muted">
        {label}
      </p>
      <p className="text-sm leading-relaxed text-clara-text">{body}</p>
    </div>
  );
}
