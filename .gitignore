# This repo root is the Windows user profile (C:\Users\redmi), not a scoped
# project dir. Deny everything by default, then allow back only what should
# actually be tracked. Without this, git status/stash walks the whole profile.

/*
!.gitignore
!.claude/
.claude/*
!.claude/skills/
!.codex-portable/
.codex-portable/*
!.codex-portable/README.md

# --- NEVER TRACK: secrets and private session data ---
# These are re-stated after the allow-list so they always win.
.claude/.credentials.json
.claude/history.jsonl
.claude/backups/
.claude/projects/
.claude/sessions/
.claude/tasks/
.claude/file-history/
.claude/shell-snapshots/
.claude/telemetry/
.claude/plans/
.claude/cache/
.claude/ide/
.claude/chrome/
.claude/session-env/
.claude/skills-backup-*/
